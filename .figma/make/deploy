#!/usr/bin/env bash
set -euo pipefail

build_dir=".figma/make/deploy-dist"
rm -rf "$build_dir"
mkdir -p "$build_dir"

cp index.html script.js styles.css "$build_dir/"
cp -R img "$build_dir/img"

[[ -d "$build_dir" ]] || {
  echo "Expected build output at $build_dir" >&2
  exit 1
}

figma make deploy --build-dir "$build_dir"
